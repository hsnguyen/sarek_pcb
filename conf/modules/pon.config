process {
    withName: 'NFCORE_SAREK:PANELS_CREATION:BAM_CREATE_SOM_PON_GATK:GATK4_MUTECT2' {
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_SAREK:PANELS_CREATION:BAM_CREATE_SOM_PON_GATK:GATK4_GENOMICSDBIMPORT' {
        ext.args   = { params.wes ? '--merge-input-intervals --genomicsdb-shared-posixfs-optimizations true --bypass-feature-reader' : '--genomicsdb-shared-posixfs-optimizations true --bypass-feature-reader' }
        ext.prefix = { meta.id }
        publishDir = [
            enabled: { !meta.pon_workspace_exists },
            mode: params.publish_dir_mode,
            path: { meta.pon_workspace_parent },
        ]
    }

    withName: 'NFCORE_SAREK:PANELS_CREATION:BAM_CREATE_SOM_PON_GATK:GATK4_CREATESOMATICPANELOFNORMALS' {
        ext.prefix = { meta.id }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/pon/${meta.id}" },
            pattern: "*{vcf.gz,vcf.gz.tbi}",
        ]
    }

    withName: 'NFCORE_SAREK:PANELS_CREATION:SAMTOOLS_VIEW' {
        ext.args = '--output-fmt bam'
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_SAREK:PANELS_CREATION:CNVKIT_BATCH' {
        ext.args = { params.wes ? '--method hybrid' : '--method wgs' }
        ext.when = true
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/pon/cnvkit" },
            pattern: '*.cnn',
        ]
    }

    withName: 'NFCORE_SAREK:PANELS_CREATION:PURECN_INTERVALFILE' {
        ext.prefix = 'purecn'
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_SAREK:PANELS_CREATION:PURECN_COVERAGE' {
        ext.prefix = { meta.id }
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_SAREK:PANELS_CREATION:PURECN_NORMALDB' {
        ext.prefix = 'purecn'
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/pon/purecn" },
            pattern: '*.{rds,png,bed}',
        ]
    }
}
