process {
    withName: 'NFCORE_PCBOMICS:PANELS_CREATION:BAM_CREATE_SOM_PON_GATK:GATK4_MUTECT2' {
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_PCBOMICS:PANELS_CREATION:BAM_CREATE_SOM_PON_GATK:GATK4_GENOMICSDBIMPORT' {
        ext.args   = { params.wes ? '--merge-input-intervals --genomicsdb-shared-posixfs-optimizations true --bypass-feature-reader' : '--genomicsdb-shared-posixfs-optimizations true --bypass-feature-reader' }
        ext.prefix = new Date().format('yyyy-MM-dd')
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/pon/mutect2/genomicsdb" },
            pattern: "*",
        ]
    }

    withName: 'NFCORE_PCBOMICS:PANELS_CREATION:BAM_CREATE_SOM_PON_GATK:GATK4_CREATESOMATICPANELOFNORMALS' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/pon/mutect2/pon_vcf" },
            pattern: "*{vcf.gz,vcf.gz.tbi}",
        ]
    }
    withName: 'NFCORE_PCBOMICS:PANELS_CREATION:CRAM_TO_BAM' {
        // Name the converted BAM after the source CRAM (minus suffix) so downstream
        // tools that derive names from the input file (e.g. CNVKit) keep their naming
        ext.prefix = { "${input.baseName}" }
        publishDir = [
            enabled: params.save_output_as_bam,
            path: { "${params.outdir}/preprocessing/converted/cram_to_bam/${meta.id}" },
            pattern: "*{bam,bam.bai}",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NFCORE_PCBOMICS:PANELS_CREATION:CNVKIT_BATCH' {
        ext.args = { params.wes ? '--method hybrid' : '--method wgs' }
        ext.when = true
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/pon/cnvkit" },
            pattern: '*.{cnn,cnr,bed,cns}',
        ]
    }

    withName: 'NFCORE_PCBOMICS:PANELS_CREATION:PURECN_INTERVALFILE' {
        ext.prefix = 'purecn_interval'
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_PCBOMICS:PANELS_CREATION:PURECN_COVERAGE' {
        ext.prefix = { meta.id }
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_PCBOMICS:PANELS_CREATION:PURECN_NORMALDB' {
        ext.prefix = 'purecn_normaldb'
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/pon/purecn" },
            pattern: '*.{rds,png,bed}',
        ]
    }
}
