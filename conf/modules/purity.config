process {
    withName: 'NFCORE_PCBOMICS:PURITY:CRAM_TO_BAM' {
        ext.prefix = { input.baseName }
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_PCBOMICS:PURITY:PURECN_INTERVALFILE' {
        ext.prefix = 'purecn_intervals'
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_PCBOMICS:PURITY:PURECN_COVERAGE' {
        ext.prefix = { meta.id }
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'NFCORE_PCBOMICS:PURITY:PURECN_RUN' {
        ext.prefix = { meta.id }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/purity/${meta.id}" },
            pattern: '*.{csv,log,pdf,seg,vcf.gz}',
        ]
    }
}
