process {
    withName: 'NFCORE_PCBOMICS:RNASEQ:RNASEQ_STAR_SALMON:FASTQC' {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/rnaseq/fastqc/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}',
        ]
    }

    withName: 'NFCORE_PCBOMICS:RNASEQ:RNASEQ_STAR_SALMON:STAR_ALIGN' {
        ext.args = '--quantMode GeneCounts --outSAMtype BAM SortedByCoordinate'
        publishDir = [
            path: { "${params.outdir}/rnaseq/star/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{Log.final.out,ReadsPerGene.out.tab,sortedByCoord.out.bam}',
        ]
    }

    withName: 'NFCORE_PCBOMICS:RNASEQ:RNASEQ_STAR_SALMON:SALMON_QUANT' {
        ext.args = { meta.strandness == 'forward' ? '--libType ISF' : meta.strandness == 'reverse' ? '--libType ISR' : '--libType A' }
        publishDir = [
            path: { "${params.outdir}/rnaseq/salmon/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_PCBOMICS:RNASEQ:RNASEQ_DESEQ2_GPROFILER2:DESEQ2_DIFFERENTIAL' {
        ext.args = '--features_type gene --feature_id_column gene_id'
        publishDir = [
            path: { "${params.outdir}/rnaseq/differential_abundance/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_PCBOMICS:RNASEQ:RNASEQ_DESEQ2_GPROFILER2:GPROFILER2_GOST' {
        ext.args = '--organism hsapiens'
        publishDir = [
            path: { "${params.outdir}/rnaseq/gprofiler2/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_PCBOMICS:RNASEQ:RNASEQ_DESEQ2_GPROFILER2:SHINYNGS_.*' {
        publishDir = [
            path: { "${params.outdir}/rnaseq/shinyngs/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_PCBOMICS:RNASEQ:RNASEQ_DESEQ2_GPROFILER2:QUARTO_NOTEBOOK' {
        ext.prefix = 'rnaseq_report'
        publishDir = [
            path: { "${params.outdir}/rnaseq/report" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,qmd,yml}',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
